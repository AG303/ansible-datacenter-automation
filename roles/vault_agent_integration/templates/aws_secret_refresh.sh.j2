#!/usr/bin/env bash
{{ ansible_managed | comment }}
# Managed by the vault_agent_integration Ansible role — do not edit by hand.
# Refreshes a secret from AWS Secrets Manager into a local file, using the
# AWS CLI with credentials supplied by the instance role/profile (configured
# outside of Ansible's control, e.g. via EC2 instance profile or ~/.aws/config).
set -euo pipefail

SECRET_ID="{{ aws_lightweight_secret_path }}"
REGION="{{ aws_region }}"
DEST_FILE="{{ aws_lightweight_dest_file }}"
DEST_MODE="{{ aws_lightweight_dest_mode }}"

aws secretsmanager get-secret-value \
  --secret-id "${SECRET_ID}" \
  --region "${REGION}" \
  --query SecretString \
  --output text > "${DEST_FILE}.tmp"

chmod "${DEST_MODE}" "${DEST_FILE}.tmp"
mv "${DEST_FILE}.tmp" "${DEST_FILE}"
