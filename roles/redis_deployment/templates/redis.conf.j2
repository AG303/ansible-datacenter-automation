{{ ansible_managed | comment(decoration='# ') }}
# Managed by the redis_deployment Ansible role — do not edit by hand.

bind {{ redis_bind_address }}
port {{ redis_port }}
protected-mode yes
tcp-keepalive {{ redis_tcp_keepalive }}
timeout {{ redis_timeout }}
databases {{ redis_databases }}

requirepass {{ redis_requirepass }}

maxmemory {{ redis_maxmemory }}
maxmemory-policy {{ redis_maxmemory_policy }}

{% if redis_persistence_mode in ['rdb', 'both'] %}
# --- RDB snapshotting ---------------------------------------------------------
{% for point in redis_rdb_save_points %}
save {{ point }}
{% endfor %}
dbfilename dump.rdb
dir /var/lib/redis
{% else %}
save ""
{% endif %}

{% if redis_persistence_mode in ['aof', 'both'] %}
# --- Append-only file persistence ---------------------------------------------
appendonly yes
appendfilename "appendonly.aof"
appendfsync {{ redis_appendfsync }}
{% else %}
appendonly no
{% endif %}

{% if redis_sentinel_enabled and redis_bind_address != redis_master_host and redis_master_host != '127.0.0.1' %}
# --- Replica of the primary (Sentinel-managed HA topology) ---------------------
replicaof {{ redis_master_host }} {{ redis_port }}
masterauth {{ redis_requirepass }}
{% endif %}

logfile /var/log/redis/redis.log
