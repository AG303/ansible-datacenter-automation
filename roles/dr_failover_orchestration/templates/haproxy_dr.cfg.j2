{{ ansible_managed | comment }}
# Managed by the dr_failover_orchestration Ansible role — do not edit by hand.
# Repoints frontend traffic to the DR-site backend pool after a failover event.

global
    log /dev/log local0
    maxconn 4096
    daemon

defaults
    log     global
    mode    http
    option  httplog
    option  dontlognull
    timeout connect 5s
    timeout client  50s
    timeout server  50s

frontend app_frontend
    bind *:443 ssl crt /etc/haproxy/certs/app.pem
    default_backend dr_site_backend

backend dr_site_backend
    balance roundrobin
    option httpchk GET /healthz
{% for host in groups[dr_site_group] %}
    server {{ host }} {{ hostvars[host]['ansible_default_ipv4']['address'] | default(host) }}:443 check ssl verify none
{% endfor %}
