{{ ansible_managed | comment }}
# Managed by the nginx_deployment Ansible role — do not edit by hand.

user {{ 'nginx' if ansible_facts['os_family'] == 'RedHat' else 'www-data' }};
worker_processes {{ nginx_worker_processes }};
worker_rlimit_nofile {{ nginx_worker_rlimit_nofile }};
error_log {{ nginx_error_log }} {{ nginx_default_error_log_level }};
pid /run/nginx.pid;

events {
    worker_connections {{ nginx_worker_connections }};
}

http {
    include       {{ '/etc/nginx/mime.types' }};
    default_type  application/octet-stream;

    log_format main '$remote_addr - $remote_user [$time_local] "$request" '
                     '$status $body_bytes_sent "$http_referer" '
                     '"$http_user_agent" "$http_x_forwarded_for"';

    access_log {{ nginx_access_log }} main;

    sendfile        on;
    tcp_nopush       on;
    tcp_nodelay      on;
    keepalive_timeout {{ nginx_keepalive_timeout }};
    client_max_body_size {{ nginx_client_max_body_size }};
    server_tokens {{ 'off' if nginx_server_tokens_off else 'on' }};

{% if nginx_gzip_enabled %}
    gzip on;
    gzip_vary on;
    gzip_proxied any;
    gzip_comp_level 5;
    gzip_types text/plain text/css application/json application/javascript text/xml
               application/xml application/xml+rss text/javascript;
{% endif %}

    include {{ nginx_vhost_enabled_dir[ansible_facts['os_family']] if ansible_facts['os_family'] == 'Debian' else nginx_vhost_dir[ansible_facts['os_family']] }}/*.conf;
}
