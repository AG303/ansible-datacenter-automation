{{ ansible_managed | comment }}
# Managed by the java_app_deployment Ansible role — do not edit by hand.

[Unit]
Description=Apache Tomcat {{ tomcat_version }}
After=network.target

[Service]
Type=forking
User={{ tomcat_service_user }}
Group={{ tomcat_service_group }}
Environment="JAVA_HOME=/usr/lib/jvm/jre-{{ java_version }}"
Environment="CATALINA_PID={{ tomcat_install_dir }}/temp/tomcat.pid"
Environment="CATALINA_HOME={{ tomcat_install_dir }}"
Environment="CATALINA_BASE={{ tomcat_install_dir }}"
Environment="CATALINA_OPTS=-Xms{{ java_heap_min }} -Xmx{{ java_heap_max }} {{ java_extra_opts }}"
ExecStart={{ tomcat_install_dir }}/bin/startup.sh
ExecStop={{ tomcat_install_dir }}/bin/shutdown.sh
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
