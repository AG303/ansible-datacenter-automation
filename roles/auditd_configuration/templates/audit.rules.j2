{{ ansible_managed | comment }}
# Managed by the auditd_configuration Ansible role — do not edit by hand.
# General best-practice audit ruleset (not mapped to any named compliance framework).

# Remove any existing rules before loading this ruleset
-D

# Buffer size — increase if "audit: backlog limit exceeded" appears in dmesg
-b 8192

# Failure mode: 0=silent 1=printk 2=panic
-f 1

{% if auditd_watch_identity %}
## --- Identity / account database watches -----------------------------------
-w /etc/passwd -p wa -k identity
-w /etc/group -p wa -k identity
-w /etc/shadow -p wa -k identity
-w /etc/gshadow -p wa -k identity
-w /etc/security/opasswd -p wa -k identity
{% endif %}

{% if auditd_watch_privilege_escalation %}
## --- Privilege escalation ---------------------------------------------------
-a always,exit -F arch=b64 -S execve -C uid!=euid -F euid=0 -k privilege_escalation
-a always,exit -F arch=b32 -S execve -C uid!=euid -F euid=0 -k privilege_escalation
-w /bin/su -p x -k privilege_escalation
-w /usr/bin/sudo -p x -k privilege_escalation
{% endif %}

{% if auditd_watch_network_config %}
## --- Network configuration ---------------------------------------------------
-w /etc/hosts -p wa -k network_config
-w /etc/sysconfig/network -p wa -k network_config
-w /etc/netplan -p wa -k network_config
-w /etc/NetworkManager -p wa -k network_config
{% endif %}

{% if auditd_watch_cron %}
## --- Scheduled tasks ------------------------------------------------------
-w /etc/crontab -p wa -k cron
-w /etc/cron.allow -p wa -k cron
-w /etc/cron.deny -p wa -k cron
-w /etc/cron.d -p wa -k cron
-w /etc/cron.hourly -p wa -k cron
-w /etc/cron.daily -p wa -k cron
-w /etc/cron.weekly -p wa -k cron
-w /etc/cron.monthly -p wa -k cron
-w /var/spool/cron -p wa -k cron
{% endif %}

{% if auditd_watch_sudoers %}
## --- Sudoers -----------------------------------------------------------------
-w /etc/sudoers -p wa -k sudoers
-w /etc/sudoers.d -p wa -k sudoers
{% endif %}

{% if auditd_watch_log_files %}
## --- Log file / login record watches ------------------------------------------
-w {{ auditd_auth_log_path[ansible_facts['os_family']] }} -p wa -k logfile_watch
-w /var/log/wtmp -p wa -k logfile_watch
-w /var/log/btmp -p wa -k logfile_watch
-w /var/log/lastlog -p wa -k logfile_watch
{% endif %}

{% for watch in auditd_extra_watches %}
-w {{ watch.path }} -p {{ watch.perms }} -k {{ watch.key }}
{% endfor %}

{% if auditd_rules_immutable %}
## --- Make the ruleset immutable until next reboot ------------------------------
-e 2
{% endif %}
